
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fehb-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fehb-management-db",
      "database_id": "4b560e6e-6f7c-41b4-ac67-fbab61312418"
    }
  ]

{
  // ...
  "vars": {
    "ALLOWED_ORIGIN": "https://fehborganization.org"
  },
  // ...
}
}
